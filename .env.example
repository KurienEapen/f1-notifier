# Server Configuration
PORT=3000

# Telegram Bot Credentials
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your chat ID by messaging your bot or via @userinfobot / @raw_data_bot
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Discord Webhook (Optional secondary channel)
DISCORD_WEBHOOK_URL=

# Monitoring Schedule (Cron syntax: e.g. every 5 minutes = */5 * * * *)
CHECK_CRON_SCHEDULE=*/5 * * * *
